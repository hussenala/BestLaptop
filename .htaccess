<IfModule mod_headers.c>
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

RewriteEngine On
RewriteBase /

RewriteRule ^api/index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api/index.php?r=/$1 [QSA,L]

# Redirect old .html URLs to clean paths
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{QUERY_STRING} ^id=([^&]+)(&.*)?$
RewriteRule ^product\.html$ /product/%1?%2 [R=301,L]
RewriteRule ^product\.html$ /products [R=301,L]
RewriteRule ^products\.html$ /products [R=301,L,QSA]
RewriteRule ^cart\.html$ /cart [R=301,L]
RewriteRule ^checkout\.html$ /checkout [R=301,L]
RewriteRule ^contact\.html$ /contact [R=301,L]
RewriteRule ^order\.html$ /order [R=301,L]

# Admin panel (Apache/static fallback when Node is not fronting requests)
RewriteRule ^admin/login/?$ admin/login.html [L]
RewriteRule ^admin/?$ admin/index.html [L]
RewriteRule ^admin/index\.html$ admin/index.html [L]
RewriteRule ^admin/([a-z0-9-]+)/?$ /admin/#/$1 [R=302,L]

# Clean URLs → static HTML pages
RewriteRule ^products/?$ products.html [L]
RewriteRule ^product/([^/]+)/?$ product.html [L]
RewriteRule ^product/?$ product.html [L]
RewriteRule ^cart/?$ cart.html [L]
RewriteRule ^checkout/?$ checkout.html [L]
RewriteRule ^contact/?$ contact.html [L]
RewriteRule ^order/?$ order.html [L]
RewriteRule ^maintenance/?$ maintenance.html [L]
