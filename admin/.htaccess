RewriteEngine On
RewriteBase /admin/

# ملفات ثابتة (css, js, صور)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# تسجيل الدخول
RewriteRule ^login/?$ login.html [L]

# لوحة التحكم — كل المسارات مثل /admin/gallery → index.html
RewriteRule ^([a-z0-9-]+)/?$ index.html [L]
